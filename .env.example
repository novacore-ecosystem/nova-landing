# Gateway origin only — each backend service supplies its own path prefix.
NEXT_PUBLIC_API_BASE_URL=

# The public landing site's own canonical origin (no trailing slash), e.g. https://acme.example.com.
# Used to build absolute canonical/Open Graph URLs in generateMetadata. Defaults to
# http://localhost:3000 in development when unset.
NEXT_PUBLIC_SITE_URL=

# nova-landing's TenantClient public key (X-Tenant-Client-Key), sent on the anonymous Bootstrap
# fetch that resolves tenant branding/nav/SEO defaults/feature flags. Not a per-user secret — see
# frontend-foundation's bootstrap module and shared/lib/bootstrap/. Until provisioned, nova-landing
# falls back to its own mock tenant config (see mocks/).
NEXT_PUBLIC_TENANT_CLIENT_KEY=

# ChatHub SignalR endpoint override. Leave unset to derive it from NEXT_PUBLIC_API_BASE_URL's
# origin (stripping a trailing /api) + /hubs/chat. Only needed once the Chat module grows a
# real-time receive path (see shared/chat's ChatTransport doc comments).
NEXT_PUBLIC_CHAT_HUB_URL=
